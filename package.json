{
  "name": "leadsphere",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-Tenant Lead Management & Outreach Portal",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:backend": "npm --prefix apps/backend run start:dev",
    "dev:frontend": "npm --prefix apps/frontend run dev",
    "build:backend": "npm --prefix apps/backend run build",
    "build:frontend": "npm --prefix apps/frontend run build",
    "test:backend": "npm --prefix apps/backend run test",
    "test:frontend": "npm --prefix apps/frontend run test"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.11"
  },
  "overrides": {
    "vite": "^5.0.11",
    "@vitejs/plugin-react": "^4.2.1",
    "@nestjs/common": "10.4.15",
    "@nestjs/core": "10.4.15",
    "@nestjs/platform-express": "10.4.15",
    "@nestjs/cli": "10.3.0",
    "@nestjs/config": "3.1.1",
    "@nestjs/swagger": "7.2.0",
    "@nestjs/typeorm": "10.0.1",
    "@nestjs/testing": "10.4.15",
    "@nestjs/schematics": "10.1.0",
    "file-type": "^19.6.0",
    "tar": "^7.5.3",
    "js-yaml": "^4.1.0",
    "lodash": "^4.17.23",
    "qs": "^6.14.0",
    "webpack": "^5.98.0",
    "uuid": "^11.1.0",
    "picomatch": "^4.0.3",
    "glob": "^10.4.5"
  }
}
